{
	"name": "n8n-nodes-pdf-page-extract",
	"version": "0.2.0",
	"description": "n8n node to extract PDF pages as an array of text",
	"keywords": [
		"n8n-community-node-package",
		"pdf",
		"extract",
		"pages",
		"text"
	],
	"license": "MIT",
	"homepage": "https://github.com/OscarWeijman/n8n-nodes-pdf-page-extract",
	"author": {
		"name": "Oscar",
		"email": "opweijman@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OscarWeijman/n8n-nodes-pdf-page-extract.git"
	},
	"engines": {
		"node": ">=22.22.0",
		"pnpm": ">=10.0"
	},
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"format": "prettier nodes test .github eslint.config.mjs pnpm-workspace.yaml package.json README.md CHANGELOG.md --write",
		"format:check": "prettier nodes test .github eslint.config.mjs pnpm-workspace.yaml package.json README.md CHANGELOG.md --check",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm lint && pnpm test && pnpm build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [],
		"nodes": [
			"dist/nodes/PdfPageExtract/PdfPageExtract.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.41.2",
		"@types/node": "22.20.1",
		"eslint": "9.29.0",
		"n8n-workflow": "2.31.3",
		"prettier": "3.9.6",
		"typescript": "5.9.3",
		"vitest": "3.2.7"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"pdfjs-dist": "6.2.108"
	},
	"overrides": {
		"brace-expansion@<1.1.17": "1.1.17",
		"brace-expansion@>=2.0.0 <2.1.3": "2.1.3",
		"form-data@>=4.0.0 <4.0.6": "4.0.6",
		"lodash@<=4.17.23": "4.18.1",
		"minimatch@>=9.0.0 <9.0.7": "9.0.9",
		"picomatch@<2.3.2": "2.3.2",
		"uuid": "11.1.1"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
