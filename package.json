{
	"name": "n8n-nodes-free-pdf-to-text",
	"version": "1.1.0",
	"description": "Free local PDF-to-text extraction for n8n — no API key, subscription, or document upload",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"pdf",
		"pdf-to-text",
		"pdf to text",
		"free pdf to text",
		"text extraction",
		"pdf parser",
		"document automation",
		"local processing",
		"offline",
		"self-hosted",
		"no api key"
	],
	"license": "MIT",
	"homepage": "https://github.com/LeonardSEO/n8n-nodes-pdf-page-extract",
	"author": {
		"name": "LeonardSEO",
		"email": "LeonardSEO@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LeonardSEO/n8n-nodes-pdf-page-extract.git"
	},
	"engines": {
		"node": ">=22.22.0",
		"pnpm": ">=10.0"
	},
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"format": "prettier nodes test scripts .github eslint.config.mjs pnpm-workspace.yaml package.json README.md CHANGELOG.md CONTRIBUTING.md --write",
		"format:check": "prettier nodes test scripts .github eslint.config.mjs pnpm-workspace.yaml package.json README.md CHANGELOG.md CONTRIBUTING.md --check",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "pnpm build && vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm lint && pnpm test",
		"test:n8n": "scripts/e2e-n8n.sh"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [],
		"nodes": [
			"dist/nodes/FreePdfToText/FreePdfToText.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.4",
		"@types/node": "22.20.1",
		"eslint": "9.29.0",
		"n8n-workflow": "2.31.3",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"vitest": "3.2.7"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"pdfjs-dist": "6.5.438"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
